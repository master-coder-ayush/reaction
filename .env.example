# Neon Postgres connection string (use the pooled connection string for serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth v5 — generate with: npx auth secret  (or: openssl rand -base64 32)
# AUTH_SECRET is the v5 name; NEXTAUTH_SECRET is kept as an alias for compatibility.
AUTH_SECRET="replace-me"
NEXTAUTH_SECRET="replace-me"

# Base URL of the app. NextAuth v5 usually infers this; set it explicitly in prod.
NEXTAUTH_URL="http://localhost:3000"
